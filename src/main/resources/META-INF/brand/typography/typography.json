{
  "brand": {
    "name": "Elicit Default Brand",
    "version": "2.0.0",
    "description": "Typography configuration for the Elicit default brand"
  },
  "typography": {
    "primary": {
      "name": "IBM Plex Sans",
      "family": "IBM Plex Sans",
      "fallback": ["IBM Plex Sans Arabic", "-apple-system", "BlinkMacSystemFont", "Roboto", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
      "weight": "normal",
      "style": "normal",
      "display": "swap"
    },
    "monospace": {
      "name": "IBM Plex Mono",
      "family": "IBM Plex Mono",
      "fallback": ["SF Mono", "Monaco", "Inconsolata", "Roboto Mono", "Consolas", "Courier New"],
      "weight": "normal",
      "style": "normal",
      "display": "swap"
    }
  },
  "styles": {
    "body": {
      "fontFamily": "IBM Plex Sans",
      "fontSize": "16px",
      "lineHeight": "1.5"
    },
    "heading": {
      "fontFamily": "IBM Plex Sans",
      "fontSize": "32px",
      "fontWeight": "600",
      "textAlign": "start",
      "textTransform": "none",
      "lineHeight": "1.25",
      "letterSpacing": "normal",
      "fontStyle": "normal"
    }
  }
}
