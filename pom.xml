            <plugin>
                <!--
                    Pitest mutation testing (https://pitest.org). Not bound to any phase: it is slow
                    and on demand only, run as `./mvnw test-compile pitest:mutationCoverage`, with the
                    report at target/pit-reports/index.html.

                    targetTests names the plain unit tests one by one, on purpose. A @QuarkusTest (or QuarkusBrowserlessTest) loads
                    the application through QuarkusClassLoader, which reads the original bytes from
                    target/classes and never sees Pitest's mutant, so every mutant it covers would be
                    reported as surviving; it would also boot the application and a PostgreSQL
                    container once per mutant. There is no glob that separates the two kinds, so a new
                    plain unit test is added here by hand; leaving one out only lowers the score, where
                    wrongly including a booted test would falsify it.

                    Two plain tests are left out because they start a PostgreSQL container of their own:
                    ManualSchemaMigratorUpgradeTest, and ManualSchemaMigratorScaleTest, which is also
                    @Disabled and seeds hundreds of thousands of rows when run on demand.
                -->
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
