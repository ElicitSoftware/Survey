            <plugin>
                <!--
                    Produces the actual jacoco.csv/html report (quarkus-jacoco alone never
                    generates one that includes non-@QuarkusTest classes, e.g. PDFServiceTest
                    constructs report.pdf/report.pdfbox classes directly with no Quarkus runtime
                    booted). The quarkus-jacoco dependency below must stay: this plugin's own
                    prepare-agent execution wins the surefire argLine race, so quarkus-jacoco's
                    own report is never produced, but its presence is still required for Quarkus
                    to build classes whose bytecode matches what this agent records against for
                    every @QuarkusTest-driven class. Removing it silently collapses coverage for
                    everything Quarkus boots (confirmed: QuestionManager dropped from ~2300 to
                    ~150 covered instructions with quarkus-jacoco removed, on an otherwise
                    identical clean build/test run).
                -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <!--
                            Coverage gate. Fails the build if bundle line coverage drops below
                            the minimum, locking in the 58.6% -> 70.2% gain rather than letting
                            it silently regress. Uses this plugin's default exec file (not
                            jacoco-quarkus.exec) to match the report execution above.
                        -->
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
