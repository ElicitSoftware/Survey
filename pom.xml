            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <configuration>
                    <skip>${license.skip}</skip>
                    <inceptionYear>2025</inceptionYear>
                    <licenseName>polyform</licenseName>
